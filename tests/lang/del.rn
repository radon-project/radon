var x = 10
assert x == 10, "x should be 10"
del x
try {
    print(x)
} catch as e {
    assert e == "'x' is not defined", "wrong error for x"
}

var a = 1
var b = 2
var c = 3
del a, b, c
try {
    print(a)
} catch as e {
    assert e == "'a' is not defined", "wrong error for a"
}
try {
    print(b)
} catch as e {
    assert e == "'b' is not defined", "wrong error for b"
}
try {
    print(c)
} catch as e {
    assert e == "'c' is not defined", "wrong error for c"
}

var arr = [1, 2, 3]
del arr
try {
    print(arr)
} catch as e {
    assert e == "'arr' is not defined", "wrong error for arr"
}

try {
    del undefined_var
} catch as e {
    assert e == "'undefined_var' is not defined", "wrong error for undefined_var"
}
