
# Basic spread: two arrays
var a = [1, 2, 3]
var b = [4, 5, 6]

print([...a, ...b])
print([...[1, 2, 3], ...[5, 6, 7]])
print([0, ...a, ...b, 7])
print([...a])

# Spread with empty array
var empty = []
print([...empty, ...a])
print([...a, ...empty])

# Spread with single-element arrays
var one = [42]
var two = [99]
print([...one, ...two])

# Spread preserves duplicates
var dupes = [1, 1, 2, 2]
print([...dupes, ...dupes])

# Multi-level spread: spread a spread result
var level1 = [...a, 4]
var level2 = [...level1, 5]
print(level2)

# Spread with function return value
fun get_nums() {
    return [10, 20, 30]
}
print([...get_nums(), 40, 50])

# Spread inside a helper function (concat)
fun concat_arrays(arr1, arr2) {
    return [...arr1, ...arr2]
}
print(concat_arrays([1, 2], [3, 4]))
print(concat_arrays([], [5, 6, 7]))

# Flatten a matrix (3 rows spread into one)
var row1 = [1, 2, 3]
var row2 = [4, 5, 6]
var row3 = [7, 8, 9]
var flat_matrix = [...row1, ...row2, ...row3]
print(flat_matrix)
print(len(flat_matrix))

# Build arrays inside a loop and spread-combine them
var evens = []
var odds = []
for i = 0 to 5 {
    if i % 2 == 0 {
        evens = [...evens, i * 2]
    } else {
        odds = [...odds, i * 2 + 1]
    }
}
print(evens)
print(odds)
print([...evens, ...odds])

# Spread a nested array literal inline
var inner = [2, 3, 4]
var outer = [1, [...inner, 5], 6]
print(outer)

# Error: spread non-array should raise RuntimeError
try {
    var s = "hello"
    var bad = [...s]
} catch as err {
    print("caught: " + err)
}

